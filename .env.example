# Variables de entorno - Copia este archivo como .env y completa tus datos

# 🔑 API Key de OpenAI (o proveedor compatible)
OPENAI_API_KEY=sk-tu-api-key-aqui

# 🧠 Modelo de IA
AI_MODEL=gpt-4o-mini

# 🌐 URL base de la API (OpenRouter)
API_BASE_URL=https://openrouter.ai/api/v1

# 🌡️ Temperatura del modelo (0.0 = preciso, 2.0 = creativo)
AI_TEMPERATURE=0.7

# 🏢 Configuración del negocio
BUSINESS_ROLE=asistente municipal de atención al público
BUSINESS_TYPE=municipalidad - gestión de turnos

# 📝 Google Keep (para leer plantillas de turnos)
# Usa una contraseña de aplicación de Google (no tu contraseña normal)
# GOOGLE_KEEP_EMAIL=tu-email@gmail.com
# GOOGLE_KEEP_PASSWORD=tu-contraseña-de-aplicacion

# 🌐 Puerto del servidor web
PORT=3000

# 🕐 Zona horaria
TZ=America/Argentina/Buenos_Aires
